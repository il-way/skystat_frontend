# AdSense 심사 직전 체크용 템플릿
# 1) 이 파일을 .env 로 복사
# 2) REPLACE_* 값만 실제 값으로 입력

VITE_ADSENSE_ENABLE_SLOTS=true
VITE_ADSENSE_PUBLISHER_ID=pub-REPLACE_WITH_REAL_PUBLISHER_ID

# Public pages
VITE_ADSENSE_SLOT_HOME_MAIN=REPLACE_WITH_SLOT_ID
VITE_ADSENSE_SLOT_GUIDE_MAIN=REPLACE_WITH_SLOT_ID
VITE_ADSENSE_SLOT_FAQ_MAIN=REPLACE_WITH_SLOT_ID
VITE_ADSENSE_SLOT_REPORT_MAIN=REPLACE_WITH_SLOT_ID

# Analysis pages
VITE_ADSENSE_SLOT_DASHBOARD_MAIN=REPLACE_WITH_SLOT_ID
VITE_ADSENSE_SLOT_VISIBILITY_BOTTOM=REPLACE_WITH_SLOT_ID
VITE_ADSENSE_SLOT_WIND_BOTTOM=REPLACE_WITH_SLOT_ID
VITE_ADSENSE_SLOT_ALTIMETER_BOTTOM=REPLACE_WITH_SLOT_ID
VITE_ADSENSE_SLOT_WEATHER_BOTTOM=REPLACE_WITH_SLOT_ID
VITE_ADSENSE_SLOT_TEMPERATURE_BOTTOM=REPLACE_WITH_SLOT_ID
VITE_ADSENSE_SLOT_WINDROSE_BOTTOM=REPLACE_WITH_SLOT_ID
